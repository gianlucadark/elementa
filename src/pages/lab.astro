---
// Fidelity bench (dev only): WebGL vs Cycles on the same camera. Not part of the public site.
import Lab from '../components/lab/Lab';
if (import.meta.env.PROD) return Astro.redirect('/');
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Elementa · Lab</title>
    <style is:global>
      :root {
        color-scheme: dark;
      }
      body {
        margin: 0;
        background: #111;
        color: #ddd;
        font: 13px/1.4 system-ui, sans-serif;
      }
      .lab {
        padding: 16px;
      }
      .bar {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        margin-bottom: 12px;
      }
      .bar label {
        display: flex;
        gap: 6px;
        align-items: center;
      }
      .bar .info {
        opacity: 0.55;
        margin-left: auto;
      }
      .stage {
        position: relative;
      }
      .frame {
        position: relative;
        transform-origin: 0 0;
        background: #000;
      }
      .frame canvas,
      .frame .poster {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
      .poster {
        pointer-events: none;
      }
      .divider {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #fff8;
        pointer-events: none;
      }
      .splitter {
        position: absolute;
        left: 0;
        right: 0;
        bottom: -28px;
        width: 100%;
      }
      .grid {
        position: absolute;
        inset: 0;
        display: grid;
        pointer-events: none;
        font: 600 28px/1 system-ui, sans-serif;
        color: #fffc;
        text-shadow: 0 1px 3px #000;
      }
      .grid > div {
        display: flex;
        align-items: flex-start;
        justify-content: flex-end;
        padding: 10px;
        border: 1px solid #fff2;
      }
      .legend {
        margin-top: 40px;
        opacity: 0.6;
      }
    </style>
  </head>
  <body>
    <Lab client:only="react" />
  </body>
</html>
