---
import Base from '../layouts/Base.astro';
import Experience from '../components/landing/Experience';
import { cuisine, occasions, restaurant } from '../content/landing';
import '../styles/landing.css';

const chapters = [
  { title: 'La sala, prima del servizio.' },
  { title: 'La tavola apparecchiata.' },
  { title: 'Vi aspettiamo.' },
];
---

<Base title="Elementa – La Magnatora | Ristorante e pizzeria a Fondi" description="A Fondi, oltre mezzo secolo di ospitalità. Cucina di mare e di terra, pasta fatta in casa, pizza al forno a legna ed eventi. Scopri Elementa – La Magnatora.">
  <link slot="head" rel="preload" as="image" href="/posters/hero-desktop.avif" type="image/avif" media="(min-width: 701px)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href="/posters/hero-mobile.avif" type="image/avif" media="(max-width: 700px)" fetchpriority="high" />
  <a class="skip-link" href="#contenuto">Vai al contenuto</a>
  <noscript><style is:inline>.scene-story{height:auto!important}.scene-shell{position:relative!important;top:0!important;height:auto!important}.scene-lines{display:flex!important;flex-direction:column;gap:15px}.scene-line{visibility:visible!important;opacity:1!important}.scene-index,.scene-skip,.scene-progress{display:none!important}.scene-editorial{position:relative!important;inset:auto!important;display:block!important;visibility:visible!important;opacity:1!important;padding:30px var(--gutter)!important;background:var(--bg)!important;color:var(--ink)!important}.scene-line p{color:var(--ink-soft)!important}.site-header{background:var(--bg)!important;color:var(--bordeaux)!important}.site-header .brand,.site-header .header-book{color:var(--bordeaux)!important}.site-header .header-book{border-color:var(--bordeaux)!important}</style></noscript>
  <header class="site-header">
    <a class="brand" href="#top" aria-label="Elementa – La Magnatora, inizio pagina"><span class="brand__name">ELEMENTA</span><span class="brand__signature">La Magnatora</span></a>
    <nav aria-label="Navigazione principale"><a class="nav-story" href="#storia">La nostra storia</a><a href="#menu">La cucina</a><a class="nav-wine" href="#cantina">La cantina</a><a class="nav-events" href="#eventi">Eventi</a></nav>
    <a class="header-book" href="#prenota">Prenota</a>
  </header>

  <main id="contenuto">
    <div id="top"></div>
    <section id="scrolly" class="scene-story" aria-labelledby="hero-title" data-chapter="0" data-intro="true">
      <div class="scene-shell">
        <div class="scene-frame">
          <picture class="poster"><source media="(max-width: 700px)" srcset="/posters/hero-mobile.avif" type="image/avif" /><source media="(max-width: 700px)" srcset="/posters/hero-mobile.webp" /><source srcset="/posters/hero-desktop.avif" type="image/avif" /><img src="/posters/hero-desktop.webp" alt="La tavola di Elementa ricostruita in 3D: legno, vetri ambrati e una candela accesa." width="1920" height="1080" fetchpriority="high" /></picture>
          <Experience client:only="react" />
          <div class="scene-shade" aria-hidden="true"></div>
          <div class="scene-exit" aria-hidden="true"></div>
          <div class="hero">
            <div class="hero__heading"><p class="eyebrow">Ristorante · Pizzeria · Fondi</p><h1 id="hero-title">Prima che<br /><em>arriviate.</em></h1></div>
            <div class="hero__aside"><p>Il tempo di stare bene, insieme.</p><a class="text-link" href="#prenota">Prenota un tavolo</a></div>
            <div class="hero__bottom eyebrow"><a href="#storia">Scopri Elementa</a></div>
          </div>
        </div>
        <div class="scene-editorial">
          
          <div class="scene-lines">{chapters.map((chapter, i) => <div class="scene-line" data-line={i}><h2>{chapter.title}</h2></div>)}</div>
          <a class="scene-skip" href="#storia" aria-label="Prosegui alla storia di Elementa">Continua</a>
        </div>
        
      </div>
    </section>

    <section class="story-section wrap section-space" id="storia" aria-labelledby="story-title">
      <div class="section-label"><span class="eyebrow">Da oltre mezzo secolo, a Fondi</span></div>
      <div class="story-section__body"><h2 id="story-title">La Magnatora,<br />oggi Elementa.</h2><div class="story-columns"><p class="lead">Una nuova pagina, una storia di ospitalità lunga oltre mezzo secolo.</p><p>Elementa affianca il nome La Magnatora e ne custodisce il legame con Fondi. Dalla cucina ai ricevimenti, continuiamo a dare spazio a ciò che ci riunisce: un pranzo in famiglia, una cena tra amici, una ricorrenza da festeggiare.</p></div><a class="text-link" href="#menu">Scopri la nostra cucina</a></div>
    </section>

    <section class="details-section wrap" aria-labelledby="details-title">
      <figure class="detail-picture"><picture><source srcset="/posters/detail.avif" type="image/avif" /><img src="/posters/detail.webp" alt="Il centrino, il tovagliolo e i riflessi dei bicchieri nella scena di Elementa." width="1920" height="1080" loading="lazy" /></picture></figure>
      <div class="details-copy"><h2 id="details-title">Intorno alla tavola.</h2><p>Ci sono pranzi che diventano pomeriggi e cene che si vorrebbe far durare ancora. La nostra idea di accoglienza parte da qui: lasciare spazio alle conversazioni, ai sapori e al piacere di ritrovarsi.</p></div>
    </section>

    <section class="menu-section section-space" id="menu" aria-labelledby="menu-title"><div class="wrap">
      <div class="menu-intro"><div><p class="eyebrow">Mare, terra e forno a legna</p><h2 id="menu-title">La nostra cucina.</h2></div><div><p>Una proposta à la carte che mette insieme il mare, i sapori della terra e la convivialità della pizza.</p></div></div>
      <div class="menu-grid">{cuisine.map(({ title, note }, i) => <article class="course"><div class="course-heading"><h3>{title}</h3><span class="eyebrow">0{i + 1}</span></div><p class="course-description">{note}</p></article>)}</div>
      <div class="menu-request"><p>Per conoscere i piatti, i prezzi e le disponibilità del momento, contattaci. Segnalaci eventuali allergie o esigenze alimentari quando prenoti.</p><a class="text-link" href={`tel:${restaurant.telephone}`}>Chiedi il menu</a></div>
    </div></section>

    <section class="wine-section wrap section-space" id="cantina" aria-labelledby="wine-title">
      <div class="wine-copy"><p class="eyebrow">Il piacere dell’abbinamento</p><h2 id="wine-title">La cantina.</h2><p>Un calice accompagna un piatto, un brindisi segna un momento. La nostra cantina riunisce vini e bollicine da accostare alla cucina e alle occasioni da celebrare.</p><p class="wine-invitation">Lasciati accompagnare nella scelta di un vino che incontri i tuoi gusti e valorizzi ciò che hai ordinato.</p><a class="text-link" href="#prenota">Ci vediamo a tavola</a></div>
      <figure class="wine-picture"><picture><source srcset="/posters/hero-evening.avif" type="image/avif" /><img src="/posters/hero-evening.webp" alt="La luce della candela e i calici sulla tavola di Elementa." width="1920" height="1080" loading="lazy" /></picture></figure>
    </section>

    <section class="events-section section-space" id="eventi" aria-labelledby="events-title"><div class="wrap">
      <div class="menu-intro"><div><p class="eyebrow">Eventi e ricevimenti</p><h2 id="events-title">Le occasioni<br />da ricordare.</h2></div><div><p>Ogni festa comincia con una buona ragione per stare insieme. Alla Magnatora, l’esperienza nell’accoglienza incontra l’attenzione per i dettagli del tuo evento.</p></div></div>
      <div class="events-grid">{occasions.map(({ title, note }) => <article><h3>{title}</h3><p>{note}</p></article>)}</div>
      <div class="event-contact"><p>Raccontaci l’occasione, la data e quante persone vorresti invitare.</p><a class="text-link" href={`mailto:${restaurant.email}?subject=${encodeURIComponent('Informazioni per un evento')}`}>Parliamo del tuo evento</a></div>
    </div></section>

    <section class="booking-section" id="prenota" aria-labelledby="booking-title"><div class="wrap booking-inner">
      <p class="eyebrow">Ti aspettiamo a Fondi</p><h2 id="booking-title">Un posto a tavola.</h2>
      <p>Per prenotare, chiamaci. Per informazioni o per organizzare un evento, puoi anche scriverci.</p>
      <div class="booking-contact"><a class="text-link" href={`tel:${restaurant.telephone}`}>Chiama {restaurant.telephoneLabel}</a><a class="text-link" href={`mailto:${restaurant.email}`}>Scrivici via email</a></div>
      <div class="visit-info">
        <div><span class="eyebrow">Dove trovarci</span><address>{restaurant.address}</address><a class="text-link" href={restaurant.maps} target="_blank" rel="noopener noreferrer">Indicazioni stradali <span aria-hidden="true">↗</span></a></div>
        <div><span class="eyebrow">Pranzo e cena</span><p>Lunedì, martedì e da giovedì a domenica<br />{restaurant.hours}</p><p class="closing-day">{restaurant.closed}</p></div>
        <div><span class="eyebrow">Contatti</span><p><a href={`tel:${restaurant.telephone}`}>{restaurant.telephoneLabel}</a></p><p><a href={`mailto:${restaurant.email}`}>{restaurant.email}</a></p></div>
      </div>
    </div></section>
  </main>
  <footer class="site-footer wrap"><a class="brand" href="#top" aria-label="Elementa – La Magnatora, torna all’inizio"><span class="brand__name">ELEMENTA</span><span class="brand__signature">La Magnatora</span></a><p class="footer-details">Fondi · Via Fossella 5<br />P. IVA {restaurant.vat}</p><a class="back-top" href="#top">Torna su ↑</a></footer>
</Base>

<script>
  // Captions work independently of WebGL, including while the model is loading.
  const track = document.querySelector<HTMLElement>('#scrolly');
  if (track) {
    const shell = track.querySelector<HTMLElement>('.scene-shell')!;
    const header = document.querySelector<HTMLElement>('.site-header')!;
    let queued = false;
    const update = () => {
      const stickyTop = parseFloat(getComputedStyle(shell).top) || 0;
      const range = track.offsetHeight - shell.offsetHeight;
      const staticScene = document.documentElement.dataset.webgl === 'off' || matchMedia('(prefers-reduced-motion: reduce)').matches;
      const p = staticScene ? 0 : Math.max(0, Math.min(1, (stickyTop - track.getBoundingClientRect().top) / Math.max(1, range)));
      track.dataset.chapter = String(p < 0.33 ? 0 : p < 0.72 ? 1 : 2);
      track.dataset.intro = String(p < 0.2);
      track.style.setProperty('--hero-opacity', String(Math.max(0, 1 - p / 0.18)));
      // Ease the paper into the lower part of the last shot before the sticky scene leaves.
      const exit = Math.max(0, Math.min(1, (p - 0.76) / 0.24));
      const fade = exit * exit * (3 - 2 * exit);
      track.style.setProperty('--exit-opacity', String(fade));
      track.dataset.exiting = String(exit > 0.85);
      header.classList.toggle('on-paper', (staticScene ? track.querySelector('.scene-frame')! : track).getBoundingClientRect().bottom <= header.offsetHeight);
      queued = false;
    };
    const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    new ResizeObserver(schedule).observe(shell);
    update();
  }
</script>
